# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Paste the full JSON contents of credentials.json (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_JSON={"installed":{"client_id":"YOUR_CLIENT_ID","client_secret":"YOUR_CLIENT_SECRET","redirect_uris":["http://localhost"]}}

# Paste the full JSON contents of token.json (generated by running: python generate_token.py)
GOOGLE_TOKEN_JSON=

# Secret key to protect your /api/chat endpoint — set any random string
LAYLA_API_KEY=your-secret-key-here

# Path for persistent memory file (locally: memory.json, on Render: /data/memory.json)
MEMORY_FILE_PATH=memory.json
